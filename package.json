{
  "name": "@art-supabase/mes-module",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.28.2"
  },
  "description": "亿企工场的 MES 制造执行应用",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "boundary:audit": "tsx scripts/audit-module-boundary.ts",
    "ui:audit": "tsx node_modules/art-supabase-pro/scripts/ui-audit.ts",
    "test:unit": "tsx --test \"src/**/*.test.ts\" \"tests/unit/*.test.ts\"",
    "lint": "eslint \"src/**/*.{ts,vue}\" \"scripts/**/*.ts\" vite.config.ts",
    "typecheck": "tsx vite.config.ts --typecheck",
    "check": "pnpm boundary:audit && pnpm ui:audit && pnpm typecheck && pnpm lint && pnpm test:unit"
  },
  "dependencies": {
    "art-supabase-pro": "https://gitee.com/art-si/art-supabase-pro/repository/archive/0b0595c6cb51896b98bd79d9ead955ca637ea8a6.tar.gz"
  },
  "peerDependencies": {
    "@vueuse/core": "^15.0.0",
    "dayjs": "^1.11.23",
    "element-plus": "^2.14.7",
    "lodash-es": "^4.18.1",
    "pinia": "4.0.3",
    "qrcode.vue": "^3.11.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/compiler-sfc": "3.5.43",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.105.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vue-tsc": "~3.3.13"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/art-si/art-supabase-mes.git"
  },
  "license": "MulanPSL-2.0"
}
